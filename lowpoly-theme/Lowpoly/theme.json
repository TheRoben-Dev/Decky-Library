{
  "name": "Lowpoly",
  "author": "TheRoben-Dev",
  "version": "v0.2.1",
  "description": "Late-90s 3D Game Mode theme: a low-resolution pre-rendered scene (fogged grid floor, flat-shaded low-poly toys, 15-bit colour with ordered dither) shown with hard pixels behind dark flat rows, thin borders and one warm accent. Covers Home, Library, game pages, Settings, menus, Quick Access, Friends & Chat, Store, Downloads, Search, Media, Achievements, keyboard and notifications. Options: accent (8 + custom), backdrop, CRT, font, animations.",
  "target": "System-Wide",
  "manifest_version": 9,
  "tabs": {
    "sp": [
      "bigpicture"
    ],
    "menu": [
      "MainMenu"
    ],
    "qam": [
      "QuickAccess"
    ],
    "toasts": [
      "notificationtoasts_.*"
    ],
    "web": [
      "store"
    ],
    "all": [
      "bigpicture",
      "MainMenu",
      "QuickAccess",
      "notificationtoasts_.*"
    ],
    "default": [
      "all",
      "web"
    ]
  },
  "inject": {
    "css/tokens.css": [],
    "css/fonts.css": [],
    "css/accents.css": [
      "sp",
      "menu",
      "qam"
    ],
    "css/controls.css": [
      "sp",
      "menu",
      "qam"
    ],
    "css/labels.css": [
      "sp",
      "menu",
      "qam"
    ],
    "css/canvas.css": [
      "sp"
    ],
    "css/shell.css": [
      "sp"
    ],
    "css/home.css": [
      "sp"
    ],
    "css/mainmenu.css": [
      "menu"
    ],
    "css/qam.css": [
      "qam"
    ],
    "css/toasts.css": [
      "sp",
      "qam",
      "toasts"
    ],
    "css/chat.css": [
      "sp",
      "qam"
    ],
    "css/pages.css": [
      "sp",
      "menu",
      "qam"
    ],
    "css/keyboard.css": [
      "sp"
    ],
    "css/store.css": [
      "web"
    ]
  },
  "patches": {
    "Accent": {
      "type": "dropdown",
      "default": "Gold",
      "values": {
        "Gold": {},
        "Amber": {
          "css/options/accent-amber.css": []
        },
        "Crimson": {
          "css/options/accent-crimson.css": []
        },
        "Lime": {
          "css/options/accent-lime.css": []
        },
        "Cyan": {
          "css/options/accent-cyan.css": []
        },
        "Violet": {
          "css/options/accent-violet.css": []
        },
        "Silver": {
          "css/options/accent-silver.css": []
        },
        "Custom": {
          "css/options/custom-colors.css": []
        }
      },
      "components": [
        {
          "name": "Accent color",
          "type": "color-picker",
          "on": "Custom",
          "default": "#E8B13A",
          "css_variable": "lp-custom-1",
          "tabs": []
        }
      ]
    },
    "Backdrop": {
      "type": "dropdown",
      "default": "3D scene",
      "values": {
        "3D scene": {},
        "Grid only": {
          "css/options/backdrop-grid.css": []
        },
        "Plain": {
          "css/options/backdrop-plain.css": []
        }
      }
    },
    "CRT": {
      "type": "dropdown",
      "default": "Off",
      "values": {
        "Off": {},
        "Scanlines": {
          "css/options/crt-scanlines.css": [
            "sp"
          ]
        },
        "Tube": {
          "css/options/crt-tube.css": [
            "sp"
          ]
        }
      }
    },
    "Font": {
      "type": "dropdown",
      "default": "Steam default",
      "values": {
        "Steam default": {},
        "Pixel labels": {
          "css/font-labels.css": [
            "sp",
            "menu",
            "qam"
          ]
        },
        "Pixel everywhere": {
          "css/font-labels.css": [
            "sp",
            "menu",
            "qam"
          ],
          "css/options/font-all.css": []
        }
      }
    },
    "Animations": {
      "type": "dropdown",
      "default": "Subtle",
      "values": {
        "Off": {},
        "Subtle": {
          "css/anim/subtle.css": [
            "sp",
            "menu",
            "qam",
            "toasts"
          ]
        },
        "Full": {
          "css/anim/subtle.css": [
            "sp",
            "menu",
            "qam",
            "toasts"
          ],
          "css/anim/full.css": [
            "sp",
            "menu",
            "qam"
          ]
        }
      }
    }
  }
}
